# OpenAI-compatible provider (required: API_KEY)
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Server
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_chunks

# Retrieval
RAG_TOP_K=3
RAG_MIN_SCORE=0

# Ingestion
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CHUNKS=500
MAX_PDF_PAGES=10
